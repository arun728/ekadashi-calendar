// Copy to Config/Secrets.xcconfig and fill in. Values are public client
// identifiers (the same kind Android receives via --dart-define).
//
// Google Sign-In: an iOS OAuth client in the Google Cloud project that also
// hosts the Firebase free-sync registry (Firebase Auth then accepts its ID
// tokens). REVERSED is the client ID with its parts reversed.
GOOGLE_IOS_CLIENT_ID = 1234567890-abcdefg.apps.googleusercontent.com
GOOGLE_REVERSED_CLIENT_ID = com.googleusercontent.apps.1234567890-abcdefg
// Firebase Web API key and project ID (same as FIREBASE_API_KEY/PROJECT_ID on Android).
FIREBASE_API_KEY =
FIREBASE_PROJECT_ID =
// Numeric App Store ID, once the app has a listing (rate/share links).
APP_STORE_ID =
DEVELOPMENT_TEAM =
