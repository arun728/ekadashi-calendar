<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_large_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="13dp">

    <!-- Top Section: Ekadashi Today / Active State Hero Card (Collapsible) -->
    <LinearLayout
        android:id="@+id/widget_large_hero_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/widget_card_background"
        android:orientation="vertical"
        android:padding="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🕉️"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/widget_large_hero_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:text="EKADASHI CALENDAR"
                android:textColor="#FFFFFF"
                android:textSize="@dimen/widget_text_title"
                android:textStyle="bold"
                android:shadowColor="#80000000"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="2" />

            <TextView
                android:id="@+id/widget_large_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/widget_badge_background"
                android:paddingLeft="8dp"
                android:paddingRight="8dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:text="NEXT EKADASHI"
                android:textColor="#FFFFFF"
                android:textSize="@dimen/widget_text_badge"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_large_hero_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Indira Ekadashi"
                android:textColor="#FFFFFF"
                android:textSize="@dimen/widget_text_hero_name_large"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="→"
                android:textColor="@color/widget_gold"
                android:textSize="@dimen/widget_text_chevron"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_large_hero_date"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="24 September 2026 • Krishna Paksha"
            android:textColor="@color/widget_text_secondary"
            android:textSize="@dimen/widget_text_date_large" />

        <!-- Timings Row -->
        <LinearLayout
            android:id="@+id/widget_large_timings_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/widget_large_fasting_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="FASTING START"
                    android:textColor="@color/widget_text_muted"
                    android:textSize="@dimen/widget_text_timing_label"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_large_fasting_val"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="05:48 AM"
                    android:textColor="#FFFFFF"
                    android:textSize="@dimen/widget_text_timing_value"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.2"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/widget_large_parana_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="PARANA WINDOW"
                    android:textColor="@color/widget_text_muted"
                    android:textSize="@dimen/widget_text_timing_label"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_large_parana_val"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="06:24 AM - 08:42 AM"
                    android:textColor="#FFFFFF"
                    android:textSize="@dimen/widget_text_timing_value"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Upcoming List Header -->
    <TextView
        android:id="@+id/widget_large_upcoming_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="5dp"
        android:text="UPCOMING EKADASHIS"
        android:textColor="#FFFFFF"
        android:textSize="@dimen/widget_text_title"
        android:textStyle="bold"
        android:shadowColor="#80000000"
        android:shadowDx="0"
        android:shadowDy="1"
        android:shadowRadius="2" />

    <!-- Scrollable Collection for Upcoming Ekadashis -->
    <ListView
        android:id="@+id/widget_large_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@android:color/transparent"
        android:dividerHeight="3dp"
        android:scrollbars="vertical"
        android:nestedScrollingEnabled="true"
        android:cacheColorHint="@android:color/transparent" />

    <!-- Empty fallback view for list -->
    <TextView
        android:id="@+id/widget_large_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="Open app to refresh upcoming Ekadashis"
        android:textColor="@color/widget_text_muted"
        android:textSize="@dimen/widget_text_date_small"
        android:visibility="gone" />

    <!-- Footer -->
    <TextView
        android:id="@+id/widget_large_footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="📍 Chennai • IST"
        android:textColor="@color/widget_text_muted"
        android:textSize="@dimen/widget_text_secondary" />

</LinearLayout>
