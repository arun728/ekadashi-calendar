<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_upcoming_item_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="5dp"
    android:background="@drawable/widget_card_background"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingLeft="10dp"
    android:paddingRight="10dp"
    android:paddingTop="9dp"
    android:paddingBottom="9dp">

    <!-- Date Column / Pill -->
    <TextView
        android:id="@+id/widget_upcoming_item_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="10dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="24 SEP"
        android:textColor="@color/widget_gold"
        android:textSize="@dimen/widget_text_list_item_date"
        android:textStyle="bold" />

    <!-- Ekadashi Name -->
    <TextView
        android:id="@+id/widget_upcoming_item_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="Indira Ekadashi"
        android:textColor="#FFFFFF"
        android:textSize="@dimen/widget_text_list_item_name"
        android:textStyle="bold" />

    <!-- Navigation Arrow -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:text="→"
        android:textColor="@color/widget_gold"
        android:textSize="@dimen/widget_text_chevron"
        android:textStyle="bold" />
</LinearLayout>
