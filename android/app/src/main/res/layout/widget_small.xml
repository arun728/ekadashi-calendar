<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_small_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="13dp">

    <!-- Header Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📅"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/widget_small_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:background="@drawable/widget_badge_background"
            android:ellipsize="end"
            android:maxLines="1"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:text="NEXT EKADASHI"
            android:textColor="#FFFFFF"
            android:textSize="@dimen/widget_text_badge"
            android:textStyle="bold"
            android:shadowColor="#80000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="2" />
    </LinearLayout>

    <!-- Ekadashi Name & Arrow -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_small_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="2"
            android:text="Indira Ekadashi"
            android:textColor="#FFFFFF"
            android:textSize="@dimen/widget_text_hero_name_small"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:text="→"
            android:textColor="@color/widget_gold"
            android:textSize="@dimen/widget_text_chevron"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Date & Paksha -->
    <TextView
        android:id="@+id/widget_small_date"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="24 September 2026"
        android:textColor="@color/widget_text_secondary"
        android:textSize="@dimen/widget_text_date_small" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Countdown / Status label -->
    <TextView
        android:id="@+id/widget_small_countdown_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="◷ STARTS IN"
        android:textColor="@color/widget_text_muted"
        android:textSize="@dimen/widget_text_countdown_label"
        android:textStyle="bold" />

    <!-- Countdown Value -->
    <TextView
        android:id="@+id/widget_small_countdown_value"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="2d 08h 36m"
        android:textColor="#FFFFFF"
        android:textSize="@dimen/widget_text_countdown_value_small"
        android:textStyle="bold" />

</LinearLayout>
