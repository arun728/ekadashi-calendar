<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/widget_background"
    android:clipToOutline="true">

    <!-- Attached Background Banner Image (decorative watermark layer) -->
    <ImageView
        android:id="@+id/widget_preview_today_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:alpha="0.28"
        android:contentDescription="@null"
        android:src="@drawable/widget_banner_bg" />

    <!-- Foreground Content -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp">

        <!-- Devotional Lotus Logo in Rounded-Square Container (Strictly Contained / No Zoom / No Crop) -->
        <ImageView
            android:id="@+id/widget_preview_today_logo"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginEnd="14dp"
            android:background="@drawable/widget_logo_background"
            android:clipToOutline="true"
            android:contentDescription="@null"
            android:scaleType="fitCenter"
            android:src="@drawable/widget_lotus_deity" />

        <!-- Card 1: EKADASHI TODAY ONLY -->
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="EKADASHI TODAY"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            android:letterSpacing="0.06" />

    </LinearLayout>

</FrameLayout>
